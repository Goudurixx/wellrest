<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/green_dark" /><stroke android:width="2dp" android:color="@color/green" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape><stroke android:width="2dp" android:color="@color/green" /><corners android:radius="100dp" /></shape>
    </item>
</selector>
